# Salin ke backend/.env untuk development. Jangan commit nilai asli.
# Lihat juga .env.local.example di root.

DATABASE_URL="mysql://finance_app:devpassword@localhost:3306/personal_finance_dev?connection_limit=5"
PORT=3000
IS_DEMO=false
# IS_DEMO=true → rate limit write lebih ketat

