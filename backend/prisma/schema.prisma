generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  bank
  cash
  e_wallet
  other
}

enum CategoryType {
  income
  expense
}

enum TransactionType {
  income
  expense
  transfer
}

enum RecurringFrequency {
  daily
  weekly
  monthly
  yearly
}

enum AssetType {
  property
  vehicle
  investment
  gold
  cash
  other
}

enum LiabilityType {
  credit_card
  loan
  other
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(191)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String?  @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  accounts             Account[]
  categories           Category[]
  transactions         Transaction[]
  budgets              Budget[]
  savingsGoals         SavingsGoal[]
  recurringTransactions RecurringTransaction[]
  assets               Asset[]
  liabilities          Liability[]

  @@map("users")
}

model Account {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  name           String    @db.VarChar(100)
  type           AccountType @default(other)
  initialBalance Decimal   @default(0) @map("initial_balance") @db.Decimal(15, 2)
  isActive       Boolean   @default(true) @map("is_active")
  notes          String?   @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  user                     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions             Transaction[]            @relation("AccountTransactions")
  transferTransactions     Transaction[]            @relation("TransferToAccount")
  savingsGoals             SavingsGoal[]
  recurringTransactions    RecurringTransaction[]

  @@index([userId], map: "idx_account_user")
  @@map("accounts")
}

model Category {
  id        Int          @id @default(autoincrement())
  userId    Int          @map("user_id")
  name      String       @db.VarChar(100)
  type      CategoryType
  parentId  Int?         @map("parent_id")
  icon      String?      @db.VarChar(50)
  color     String?      @db.VarChar(7)
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]  @relation("CategoryTree")

  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]

  @@unique([userId, name, type], map: "uq_category_name_type")
  @@index([userId], map: "idx_category_user")
  @@map("categories")
}

model Transaction {
  id                 Int             @id @default(autoincrement())
  userId             Int             @map("user_id")
  accountId          Int             @map("account_id")
  categoryId         Int?            @map("category_id")
  type               TransactionType
  amount             Decimal         @db.Decimal(15, 2)
  transactionDate    DateTime        @map("transaction_date") @db.Date
  description        String?         @db.VarChar(255)
  transferToAccountId Int?           @map("transfer_to_account_id")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at")

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account   @relation("AccountTransactions", fields: [accountId], references: [id])
  category          Category? @relation(fields: [categoryId], references: [id])
  transferToAccount Account?  @relation("TransferToAccount", fields: [transferToAccountId], references: [id])

  @@index([userId], map: "idx_trx_user")
  @@index([transactionDate], map: "idx_trx_date")
  @@index([accountId], map: "idx_trx_account")
  @@index([categoryId], map: "idx_trx_category")
  @@map("transactions")
}

model Budget {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  categoryId   Int      @map("category_id")
  month        Int      @db.TinyInt
  year         Int      @db.SmallInt
  budgetAmount Decimal  @map("budget_amount") @db.Decimal(15, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month, year], map: "uq_budget_period")
  @@index([userId], map: "idx_budget_user")
  @@map("budgets")
}

model SavingsGoal {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  name         String    @db.VarChar(100)
  targetAmount Decimal   @map("target_amount") @db.Decimal(15, 2)
  targetDate   DateTime? @map("target_date") @db.Date
  accountId    Int?      @map("account_id")
  notes        String?   @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id])

  @@index([userId], map: "idx_goal_user")
  @@map("savings_goals")
}

model RecurringTransaction {
  id          Int                @id @default(autoincrement())
  userId      Int                @map("user_id")
  accountId   Int                @map("account_id")
  categoryId  Int?               @map("category_id")
  type        CategoryType
  amount      Decimal            @db.Decimal(15, 2)
  description String?            @db.VarChar(255)
  frequency   RecurringFrequency
  startDate   DateTime           @map("start_date") @db.Date
  endDate     DateTime?          @map("end_date") @db.Date
  nextRunDate DateTime           @map("next_run_date") @db.Date
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([userId], map: "idx_recurring_user")
  @@index([nextRunDate, isActive], map: "idx_recurring_next_run")
  @@map("recurring_transactions")
}

model Asset {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  name      String    @db.VarChar(100)
  type      AssetType @default(other)
  value     Decimal   @db.Decimal(15, 2)
  notes     String?   @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_asset_user")
  @@map("assets")
}

model Liability {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  name      String        @db.VarChar(100)
  type      LiabilityType @default(other)
  amount    Decimal       @db.Decimal(15, 2)
  notes     String?       @db.VarChar(255)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_liability_user")
  @@map("liabilities")
}

/// Saldo terkini tiap akun (dihitung, bukan disimpan). CREATE VIEW ada di migration SQL.
/// v_monthly_summary juga dibuat di migration; query lewat $queryRaw (tanpa unique key alami).
view VAccountBalance {
  accountId      Int         @unique @map("account_id")
  accountName    String      @map("account_name") @db.VarChar(100)
  accountType    AccountType @map("account_type")
  userId         Int         @map("user_id")
  currentBalance Decimal     @map("current_balance") @db.Decimal(15, 2)

  @@map("v_account_balances")
}
