# Salin jadi .env.local (atau .env, sesuai setup NestJS-mu) untuk development lokal.
# Ini connect ke MySQL native yang sudah jalan di Windows (dikelola/dilihat lewat DBeaver),
# BUKAN Docker dan BUKAN ke VPS.
#
# connection_limit opsional di lokal; tetap disarankan biar kebiasaan sama production.

DATABASE_URL="mysql://finance_app:devpassword@localhost:3306/personal_finance_dev?connection_limit=5"
PORT=3000
IS_DEMO=false
