# Salin file ini jadi .env.production dan .env.demo di server,
# isi dengan nilai asli. JANGAN commit .env.production / .env.demo ke git.
#
# connection_limit=5 → batasi pool Prisma (VPS kecil, hemat koneksi MySQL).
# Host DB di Docker network: mysql-db (bukan localhost).

DATABASE_URL="mysql://finance_app:PASSWORD_DISINI@mysql-db:3306/personal_finance?connection_limit=5"
PORT=3000
IS_DEMO=false
# IS_DEMO=true → rate limit write lebih ketat (20/menit, burst 5/10dtk)

# ---- Auth ----
# Secret utk sign JWT. WAJIB ganti dengan nilai acak yang panjang di produksi.
JWT_SECRET="ganti-dengan-secret-acak-panjang"
# Berapa hari token berlaku sebelum login ulang (default 30)
SESSION_TTL_DAYS=30
# Email akun demo. Seed + tombol login ikut nilai ini (default demo@ledger.app).
DEMO_EMAIL="demo@ledger.app"
# Cron 5-field (menit jam hari bulan hari-minggu). Default: sekali sehari 00:00 Asia/Jakarta.
# Nanti lebih sering: DEMO_RESET_CRON="0 */6 * * *"  (tiap 6 jam)
# DEMO_RESET_CRON="0 0 * * *"
